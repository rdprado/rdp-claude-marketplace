{
  "Logs": {
    "FilePath": "C:/logs/orders-example/log.txt",
    "AuditFilePath": "C:/logs/orders-example/audit.txt",
    "RetainedDays": 90
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "DevIdentityProvider": {
    "Issuer": "http://localhost:5180/dev-idp",
    "Audience": "orders-example-api",
    "RedirectUris": [
      "http://localhost:5173/auth/callback"
    ]
  },
  "AllowedHosts": "*"
}
